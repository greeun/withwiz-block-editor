# nodejs .gitignore
node_modules/
dist/
build/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*.local
coverage/
.nyc_output/
.cache/
.DS_Store
Thumbs.db
.serena/
docs/.pdca*
docs/.bkit*
docs/superpowers/

# superpowers (auto-installed; do not track)
.superpowers/

# npm is the package manager for this repo (package-lock.json); do not track other lockfiles
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock

# claude code (지침 문서 · 로컬 설정 · 세션 워크트리 · 자동 설치 스킬 · MCP 설정)
CLAUDE.md
.claude/
.claude.json
.claude.json.*
.claude-*.json

# axt 로컬 프로파일 (백업본 포함)
.axt/
.axt*

# ast (agent session tracker) 로컬 산출물
.ast/
.ast*
